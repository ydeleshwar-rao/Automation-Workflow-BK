# ============================================================
# Backend Environment Variables — New Supabase Setup
# Copy this file to .env and fill in your values
# ============================================================

# ── New Supabase Project ────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Prisma database connection (from Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Custom JWT Secrets ──────────────────────────────────────
# Generate strong random secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=generate-32-char-random-hex-here
JWT_REFRESH_SECRET=generate-different-32-char-random-hex-here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── App ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Redis (for BullMQ workflow queue) ───────────────────────
REDIS_URL=redis://localhost:6379

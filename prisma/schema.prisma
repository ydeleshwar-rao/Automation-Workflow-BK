// =============================================================================
// Prisma Schema — generated from Supabase SQL schema
//
// Migration guide (moving away from Supabase):
//   1. Remove previewFeatures = ["multiSchema"] from generator
//   2. Remove `schemas = [...]` from datasource and change provider
//   3. Remove all @@schema() directives
//   4. Replace the User model (auth.users) with your own auth table and remove
//      @@map("users") / @@schema("auth")
//   5. Remove @db.Uuid if targeting SQLite/MySQL < 8 (use plain String)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  admin
  developer
  user

  @@schema("public")
}

enum WebhookMode {
  test
  live

  @@schema("public")
}

enum WebhookStatus {
  active
  inactive
  archived

  @@schema("public")
}

enum WorkflowTemplateStatus {
  active
  inactive
  draft

  @@schema("public")
}

// ─── Auth User ───────────────────────────────────────────────────────────────
// Maps to auth.users (Supabase-managed). On migration to another DB:
//   - Remove @@schema("auth") and @@map("users")
//   - Add your own fields (email, password_hash, etc.)
//   - Run prisma migrate to create the table

model User {
  id String @id @default(uuid()) @db.Uuid

  profile                      Profile?
  commussoftIntegration        CommussoftIntegration?
  commussoftJobMaterials       CommussoftJobMaterial[]
  commussoftPartsAndPrices     CommussoftPartsAndPrices[]
  commussoftStaff              CommussoftStaff[]
  developerPermissionsAsOwner  DeveloperPermission[]    @relation("DeveloperAsDev")
  developerPermissionsAsClient DeveloperPermission[]    @relation("DeveloperAsClient")
  emailLogs                    EmailLog[]
  quickbooksIntegration        QuickbooksIntegration?
  servicem8Integration         Servicem8Integration?
  servicem8JobMaterials        Servicem8JobMaterial[]
  servicem8Queues              Servicem8Queue[]
  simproIntegration            SimproIntegration?
  smtpConnections              SmtpConnection[]
  userIntegration              UserIntegration?
  xeroIntegration              XeroIntegration?

  @@map("users")
  @@schema("auth")
}

// ─── Profiles ────────────────────────────────────────────────────────────────

model Profile {
  id              String   @id @db.Uuid
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  email           String?
  phone           String?
  companyName     String?  @map("company_name")
  role            Role?    @default(user)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  clientkey       String?  @unique
  jobAppType      String?  @map("job_app_type")
  avatarUrl       String?  @map("avatar_url")
  websiteUrl      String?  @map("website_url")
  pagePermissions Json?    @default("{\"charts\": true, \"workflow\": true}") @map("page_permissions")

  user User @relation(fields: [id], references: [id])

  commussoftCustomers      CommussoftCustomer[]
  commussoftCustomerTypes  CommussoftCustomerType[]
  commussoftJobs           CommussoftJob[]
  commussoftUserPreferences CommussoftUserPreference[]
  permissions              Permission[]
  servicem8Categories      Servicem8Category[]
  servicem8Contacts        Servicem8Contact[]
  servicem8JobActivities   Servicem8JobActivity[]
  servicem8JobPayments     Servicem8JobPayment[]
  servicem8Jobs            Servicem8Job[]
  servicem8Locations       Servicem8Location[]
  servicem8Materials       Servicem8Material[]
  servicem8Notes           Servicem8Note[]
  servicem8SiteDetails     Servicem8SiteDetail[]
  servicem8Staff           Servicem8Staff[]
  templateFolders          TemplateFolder[]
  userClientAccessAsUser   UserClientAccess[]  @relation("UserClientAccessUser")
  userClientAccessAsClient UserClientAccess[]  @relation("UserClientAccessClient")
  workflowTemplates        WorkflowTemplate[]
  workflowsLastEdited      Workflow[]          @relation("WorkflowLastEditedBy")
  workflowsCurrentEditing  Workflow[]          @relation("WorkflowCurrentEditor")

  @@map("profiles")
  @@schema("public")
}

// ─── Commusoft ───────────────────────────────────────────────────────────────

model CommussoftCustomer {
  id                             BigInt   @id
  userId                         String   @map("user_id") @db.Uuid
  contactid                      BigInt?
  title                          String?
  titleId                        BigInt?
  name                           String?
  surname                        String?
  companyname                    String?
  servicereminderpreference      String?
  parentpropertiesid             BigInt?
  addressline1                   String?
  addressline2                   String?
  addressline3                   String?
  town                           String?
  county                         String?
  postcode                       String?
  latitude                       Decimal?
  longitude                      Decimal?
  settingsTypesofbuildingsid     BigInt?
  vacant                         Int?
  accountingsystemreference      String?
  emailaddress                   String?
  countrycode                    String?
  telephonenumber                String?
  invoiceAddressId               BigInt?
  auditSenttoaccountingsystemsid BigInt?
  pricebookid                    BigInt?
  customertypesid                String?

  // Dual FK in Supabase (auth.users + profiles) — Prisma uses profiles
  profile Profile @relation(fields: [userId], references: [id])

  @@map("commusoft_customers")
  @@schema("public")
}

model CommussoftCustomerType {
  uuid                 String    @id @db.Uuid
  createdondatetime    DateTime?
  createdbytype        Int?
  createdbyid          Int?
  id                   Int?      @unique
  lastmodifieddatetime DateTime?
  description          String?
  customerdescription  String?
  companynamerequired  Boolean?
  allowforbranches     Boolean?
  typeofjobaddress     String?
  sortOrder            Int?      @map("order")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  userId               String?   @map("user_id") @db.Uuid

  profile Profile? @relation(fields: [userId], references: [id])

  @@map("commusoft_customertype")
  @@schema("public")
}

model CommussoftIntegration {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  clientid      String?
  username      String?
  password      String?
  applicationid String?
  createdAt     DateTime @default(now()) @map("created_at")
  accessToken   String?  @map("access_token")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("commusoft_intigrations")
  @@schema("public")
}

model CommussoftJobMaterial {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique
  jobUuid         String?   @map("job_uuid")
  name            String?
  quantity        Decimal?
  unitPrice       Decimal?  @map("unit_price")
  unitCost        Decimal?  @map("unit_cost")
  cost            Decimal?
  displayedAmount String?   @map("displayed_amount")
  displayedCost   String?   @map("displayed_cost")
  notes           String?
  active          Int?      @default(1)
  editDate        DateTime? @map("edit_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  userId          String    @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("commusoft_job_materials")
  @@schema("public")
}

// Column names with spaces/dots are preserved via @map — Prisma quotes them automatically
model CommussoftJob {
  id                       String  @id @default(uuid()) @db.Uuid
  userId                   String  @map("user_id") @db.Uuid
  customerName             String? @map("Customer Name")
  customerAccountNumber    String? @map("Customer.Account.Number")
  workAddressAccountNumber String? @map("Work.Address.Account.Number")
  customerLandline         String? @map("Customer Landline")
  customerMobile           String? @map("Customer Mobile")
  customerEmail            String? @map("Customer Email")
  customerAddressLine1     String? @map("Customer Address Line 1")
  landlordName             String? @map("Landlord Name")
  jobNumber                String? @map("Job Number")
  jobDate                  String? @map("Job Date")
  contactName              String? @map("Contact Name")
  jobDescription           String? @map("Job Description")
  jobNotes                 String? @map("Job Notes")
  customerReference        String? @map("Customer reference")
  quotedAmount             String? @map("Quoted Amount")
  jobAddressName           String? @map("Job Address Name")
  jobAddressLine1          String? @map("Job Address Line 1")
  jobAddressLine2          String? @map("Job Address Line 2")
  jobAddressLine3          String? @map("Job Address Line 3")
  jobAddressTown           String? @map("Job Address Town")
  jobAddressCounty         String? @map("Job Address County")
  jobAddressPostcode       String? @map("Job Address Postcode")
  jobAddressTelephone      String? @map("Job Address Telephone")
  jobAddressMobile         String? @map("Job Address Mobile")
  jobAddressEmail          String? @map("Job Address Email")
  numberOfDiaryEvents      String? @map("Number of Diary Events")
  priority                 String? @map("Priority")
  businessUnit             String? @map("Business unit")
  additionalContact        String? @map("Additional Contact")
  lastDiaryEvent           String? @map("Last Diary Event")
  nextDiaryEvent           String? @map("Next Diary Event")
  lastEngineerNameOnSite   String? @map("Last Engineer Name On Site")
  nextEngineerNameOnSite   String? @map("Next Engineer Name On Site")
  lastEngineerMobileStatus String? @map("Last Engineer Mobile Status")
  isJobComplete            String? @map("Is Job Complete")
  isARecall                String? @map("Is a Recall")
  numberOfInvoicesRaised   String? @map("Number of Invoices Raised")
  engineerName             String? @map("Engineer Name")
  jobUuid                  String? @map("Job Uuid") @db.Uuid
  jobPropertyType          String? @map("Job Property Type")
  jobPropertyUuid          String? @map("Job Property Uuid") @db.Uuid
  jobCustomerId            String? @map("Job Customer Id")
  createdFrom              String? @map("Created From")
  preferredDate            String? @map("Preferred date")
  completedDate            String? @map("Completed Date")
  jobOnHoldReasons         String? @map("Job on hold reasons")
  customerContract         String? @map("Customer contract")
  jobContract              String? @map("Job contract")
  numberOfCertificates     String? @map("Number of certificates")
  jobStage                 String? @map("Job stage")
  jobStageColor            String? @map("JobStageColor")
  jobId                    String?
  propertyId               String?
  parentPropertyId         String?

  profile Profile @relation(fields: [userId], references: [id])

  @@map("commusoft_jobs")
  @@schema("public")
}

model CommussoftPartsAndPrices {
  id                     BigInt    @id @default(autoincrement())
  uuid                   String    @unique
  description            String?
  barcode                String?
  type                   String?
  make                   String?
  model                  String?
  manufacturerPartNumber String?   @map("manufacturer_part_number")
  price                  Decimal?
  markup                 Decimal?
  vat                    String?
  createdOnDatetime      DateTime? @map("created_on_datetime")
  lastModifiedDatetime   DateTime? @map("last_modified_datetime")
  active                 Int?      @default(1)
  createdAt              DateTime  @default(now()) @map("created_at")
  userId                 String    @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("commusoft_parts_and_prices")
  @@schema("public")
}

model CommussoftStaff {
  uuid                    String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  createdondatetime       DateTime?
  createdbytype           Int?
  createdbyid             Int?
  commussoftId            Int?      @unique @map("commusoft_id")
  username                String?
  settingsClientbranchesid Int?     @map("settings_clientbranchesid")
  name                    String?
  surname                 String?
  addressline1            String?
  addressline2            String?
  addressline3            String?
  town                    String?
  county                  String?
  telephone               String?
  mobilecountrycode       Int?
  mobile                  String?
  email                   String?
  profilepicture          String?
  appearondiary           Boolean?
  nationalinsurance       String?
  usertype                String?
  status                  String?
  colourondiary           String?
  signature               String?
  jmsroleid               Json?
  gps                     Json?
  sipSettings             Json?
  insertedAt              DateTime  @default(now()) @map("inserted_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  datejoined              String?
  gasregistrationnumber   String?
  id                      Int?
  idcardnumber            String?
  securityquestion        String?
  settingsSecurityrolesid Json?     @map("settings_securityrolesid")
  suspended               Boolean?
  telephonecountrycode    Int?

  user User @relation(fields: [userId], references: [id])

  @@map("commusoft_staff")
  @@schema("public")
}

model CommussoftUserPreference {
  id       Int      @id
  userId   String   @map("user_id") @db.Uuid
  checked  Boolean?
  position Int?

  profile Profile @relation(fields: [userId], references: [id])

  @@map("commusoft_userpreference")
  @@schema("public")
}

// ─── Developer Permissions ───────────────────────────────────────────────────

model DeveloperPermission {
  id           String   @id @default(uuid()) @db.Uuid
  developerId  String   @map("developer_id") @db.Uuid
  clientUserId String   @map("client_user_id") @db.Uuid
  page         String
  canRead      Boolean  @default(false) @map("can_read")
  canWrite     Boolean  @default(false) @map("can_write")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  developer  User @relation("DeveloperAsDev", fields: [developerId], references: [id])
  clientUser User @relation("DeveloperAsClient", fields: [clientUserId], references: [id])

  @@map("developer_permissions")
  @@schema("public")
}

// ─── Email ───────────────────────────────────────────────────────────────────

model EmailLog {
  id           String    @id @db.Uuid
  smtpId       String    @map("smtp_id") @db.Uuid
  templateId   String    @map("template_id") @db.Uuid
  toEmail      String    @map("to_email")
  subject      String?
  status       String
  attemptCount Int?      @default(1) @map("attempt_count")
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @default(now()) @map("sent_at")
  // cc/bcc/attachment were ARRAY in Postgres — stored as Json for cross-DB portability
  cc           Json?
  bcc          Json?
  attachment   Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  userId       String    @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@map("email_logs")
  @@schema("public")
}

model EmailTemplate {
  id             String   @id @db.Uuid
  name           String
  subject        String
  htmlTemplate   String   @map("html_template")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  defaultReplyTo String?  @map("default_reply_to")
  body           String?

  @@map("email_templates")
  @@schema("public")
}

// ─── Integration Webhook Subscriptions ───────────────────────────────────────

model IntegrationWebhookSubscription {
  id                     String    @id @default(uuid()) @db.Uuid
  workflowId             String    @map("workflow_id") @db.Uuid
  nodeId                 String    @unique @map("node_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  integrationKey         String    @map("integration_key")
  eventKey               String    @map("event_key")
  config                 Json?     @default("{}")
  externalSubscriptionId String?   @map("external_subscription_id")
  targetPath             String    @map("target_path")
  signingSecret          String?   @map("signing_secret")
  isActive               Boolean   @default(true) @map("is_active")
  lastReceivedAt         DateTime? @map("last_received_at")
  totalReceived          Int       @default(0) @map("total_received")
  errorCount             Int       @default(0) @map("error_count")
  lastError              String?   @map("last_error")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  workflow  Workflow         @relation(fields: [workflowId], references: [id])
  node      WorkflowNode     @relation(fields: [nodeId], references: [id])
  eventLogs WebhookEventLog[]

  @@map("integration_webhook_subscriptions")
  @@schema("public")
}

// ─── LeadsHub ────────────────────────────────────────────────────────────────

model LeadshubContact {
  id               String    @id @default(uuid()) @db.Uuid
  ghlContactId     String    @map("ghl_contact_id")
  locationId       String    @map("location_id")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  email            String?
  phone            String?
  tags             Json?
  rawData          Json?     @map("raw_data")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  contactName      String?   @map("contact_name")
  companyName      String?   @map("company_name")
  type             String?
  source           String?
  assignedTo       String?   @map("assigned_to")
  city             String?
  state            String?
  postalCode       String?   @map("postal_code")
  country          String?
  website          String?
  timezone         String?
  dnd              Boolean?
  dateAdded        DateTime? @map("date_added")
  dateUpdated      DateTime? @map("date_updated")
  attributions     Json?
  customFields     Json?     @map("custom_fields")
  firstNameRaw     String?   @map("first_name_raw")
  lastNameRaw      String?   @map("last_name_raw")
  additionalEmails Json?     @map("additional_emails")
  dndSettings      Json?     @map("dnd_settings")
  address1         String?
  businessId       String?   @map("business_id")
  followers        Json?
  profilePhoto     String?   @map("profile_photo")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  startAfter       Json?     @map("start_after")

  @@map("leadshub_contacts")
  @@schema("public")
}

model LeadshubIntegration {
  id           BigInt    @id @default(autoincrement())
  createdAt    DateTime  @default(now()) @map("created_at")
  companyId    String?   @map("company_id")
  locationId   String?   @map("location_id")
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresIn    BigInt?   @map("expires_in")
  userType     String?   @map("user_type")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  expiresAt    DateTime? @map("expires_at")
  isActive     Boolean   @default(true) @map("is_active")
  userId       String?   @map("user_id") @db.Uuid

  @@map("leadshub_integrations")
  @@schema("public")
}

model LeadshubOpportunity {
  id                 String    @id
  locationId         String    @map("location_id")
  contactId          String    @map("contact_id")
  name               String?
  monetaryValue      Decimal   @default(0) @map("monetary_value")
  pipelineId         String?   @map("pipeline_id")
  pipelineStageId    String?   @map("pipeline_stage_id")
  assignedTo         String?   @map("assigned_to")
  status             String?
  source             String?
  lostReasonId       String?   @map("lost_reason_id")
  lastStatusChangeAt DateTime? @map("last_status_change_at")
  lastStageChangeAt  DateTime? @map("last_stage_change_at")
  createdAt          DateTime? @map("created_at")
  updatedAt          DateTime? @map("updated_at")
  contactName        String?   @map("contact_name")
  contactEmail       String?   @map("contact_email")
  contactPhone       String?   @map("contact_phone")
  contactCompanyName String?   @map("contact_company_name")
  contactTags        Json      @default("[]") @map("contact_tags")
  customFields       Json      @default("[]") @map("custom_fields")
  followers          Json      @default("[]")
  insertedAt         DateTime  @default(now()) @map("inserted_at")

  @@map("leadshub_opportunities")
  @@schema("public")
}

model LeadshubPipelineStage {
  id         String   @id
  pipelineId String   @map("pipeline_id")
  locationId String   @map("location_id")
  name       String
  position   Int?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("leadshub_pipeline_stages")
  @@schema("public")
}

model LeadshubPipeline {
  id                        String   @id
  locationId                String   @map("location_id")
  name                      String
  originId                  String?  @map("origin_id")
  useOpportunityProbability Boolean  @default(false) @map("use_opportunity_probability")
  stages                    Json     @default("[]")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("leadshub_pipelines")
  @@schema("public")
}

// ─── Permissions ─────────────────────────────────────────────────────────────

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  page      String
  canRead   Boolean  @default(true) @map("can_read")
  canWrite  Boolean  @default(false) @map("can_write")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id])

  @@map("permissions")
  @@schema("public")
}

// ─── Polling ─────────────────────────────────────────────────────────────────

model PollingSeenRecord {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  externalId     String   @map("external_id")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")

  subscription PollingSubscription @relation(fields: [subscriptionId], references: [id])

  @@map("polling_seen_records")
  @@schema("public")
}

model PollingSubscription {
  id             String    @id @default(uuid()) @db.Uuid
  workflowId     String    @map("workflow_id") @db.Uuid
  nodeId         String    @unique @map("node_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  integrationKey String    @map("integration_key")
  eventKey       String    @map("event_key")
  config         Json?     @default("{}")
  pollInterval   Int       @default(300) @map("poll_interval")
  cursorValue    String?   @map("cursor_value")
  cursorType     String?   @default("timestamp") @map("cursor_type")
  lastPolledAt   DateTime? @map("last_polled_at")
  lastError      String?   @map("last_error")
  errorCount     Int       @default(0) @map("error_count")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workflow    Workflow            @relation(fields: [workflowId], references: [id])
  node        WorkflowNode        @relation(fields: [nodeId], references: [id])
  seenRecords PollingSeenRecord[]

  @@map("polling_subscriptions")
  @@schema("public")
}

// ─── QuickBooks ──────────────────────────────────────────────────────────────

model QuickbooksIntegration {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  realmId      String?  @map("realm_id")
  isConnected  Boolean  @default(false) @map("is_connected")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("quickbooks_integrations")
  @@schema("public")
}

// ─── ServiceM8 ───────────────────────────────────────────────────────────────

model Servicem8Category {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  uuid      String    @unique
  name      String?
  colour    String?
  active    Int       @default(1)
  editDate  DateTime? @map("edit_date")
  createdAt DateTime  @default(now()) @map("created_at")

  // Dual FK in Supabase (auth.users + profiles) — Prisma uses profiles
  profile Profile        @relation(fields: [userId], references: [id])
  jobs    Servicem8Job[]

  @@map("servicem8_categories")
  @@schema("public")
}

model Servicem8Contact {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  uuid             String    @unique
  companyUuid      String?   @map("company_uuid")
  first            String?
  last             String?
  email            String?
  phone            String?
  mobile           String?
  type             String?
  isPrimaryContact String    @default("0") @map("is_primary_contact")
  active           Int       @default(1)
  editDate         DateTime? @map("edit_date")
  createdAt        DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id])

  @@map("servicem8_contacts")
  @@schema("public")
}

model Servicem8Integration {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  accessToken    String    @map("access_token")
  expiresAt      DateTime  @map("expires_at")

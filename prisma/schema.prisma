}

model WorkflowTemplateMapping {
  id             String   @id @default(uuid()) @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  templateNodeId String   @map("template_node_id") @db.Uuid
  mappings       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  template     WorkflowTemplate     @relation(fields: [templateId], references: [id])
  templateNode WorkflowTemplateNode @relation(fields: [templateNodeId], references: [id])

  @@map("workflow_template_mappings")
  @@schema("public")
}

model WorkflowTemplateNode {
  id                  String    @id @default(uuid()) @db.Uuid
  templateId          String    @map("template_id") @db.Uuid
  type                String
  nodeCategory        String?   @map("node_category")
  integrationKey      String    @map("integration_key")
  actionKey           String?   @map("action_key")
  configSchema        Json?     @map("config_schema")
  requiredCredentials Json?     @map("required_credentials")
  outputSchema        Json?     @map("output_schema")
  position            Int
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  template WorkflowTemplate          @relation(fields: [templateId], references: [id])
  mappings WorkflowTemplateMapping[]

  @@map("workflow_template_nodes")
  @@schema("public")
}

model WorkflowTemplate {
  id               String                 @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  category         String?
  tag              String?
  sourceWorkflowId String?                @map("source_workflow_id") @db.Uuid
  createdBy        String?                @map("created_by") @db.Uuid
  isPublic         Boolean                @default(false) @map("is_public")
  usageCount       Int                    @default(0) @map("usage_count")
  status           WorkflowTemplateStatus @default(active)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  templateFolderId String?                @map("template_folder_id") @db.Uuid

  sourceWorkflow Workflow?              @relation("WorkflowTemplates", fields: [sourceWorkflowId], references: [id])
  creator        Profile?              @relation(fields: [createdBy], references: [id])
  folder         TemplateFolder?       @relation(fields: [templateFolderId], references: [id])
  nodes          WorkflowTemplateNode[]
  mappings       WorkflowTemplateMapping[]

  @@map("workflow_templates")
  @@schema("public")
}

model Workflow {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid // no FK constraint in source schema
  name                String
  status              String?   @default("draft")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  tag                 String?
  folderId            String?   @map("folder_id") @db.Uuid
  position            Int       @default(0)
  lastEditedByUserId  String?   @map("last_edited_by_user_id") @db.Uuid
  lastEditedAt        DateTime? @map("last_edited_at")
  currentEditorUserId String?   @map("current_editor_user_id") @db.Uuid
  editingStartedAt    DateTime? @map("editing_started_at")
  editingLastPingAt   DateTime? @map("editing_last_ping_at")
  lastEditedBy        String?   @map("last_edited_by")
  lastEditedByName    String?   @map("last_edited_by_name")

  folder          WorkflowFolder?                  @relation(fields: [folderId], references: [id])
  lastEditorUser  Profile?                         @relation("WorkflowLastEditedBy", fields: [lastEditedByUserId], references: [id])
  currentEditor   Profile?                         @relation("WorkflowCurrentEditor", fields: [currentEditorUserId], references: [id])
  nodes           WorkflowNode[]
  executions      WorkflowExecution[]
  tagLinks        WorkflowTagLink[]
  webhooks        Webhook[]
  webhookSubs     IntegrationWebhookSubscription[]
  pollingSubs     PollingSubscription[]
  templates       WorkflowTemplate[]               @relation("WorkflowTemplates")

  @@map("workflows")
  @@schema("public")
}

// ─── Xero ────────────────────────────────────────────────────────────────────

model XeroIntegration {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  tenantId     String?  @map("tenant_id")
  isConnected  Boolean  @default(false) @map("is_connected")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("xero_integrations")
  @@schema("public")
}
